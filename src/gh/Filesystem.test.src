test("Filesystem").expect("touch can create a file").is = function(assert)
    parent_folder = parent_path(program_path())
    result = Filesystem.touch(get_shell(), parent_folder + "/testfile1")
    assert.is_true(result)
    assert.equals(typeof(Filesystem.get_file(get_shell(), parent_folder + "/testfile1")), "file")

    result = Filesystem.touch(get_shell().host_computer(), parent_folder + "/testfile2")
    assert.is_true(result)
    assert.equals(typeof(Filesystem.get_file(get_shell(), parent_folder + "/testfile2")), "file")

    result = Filesystem.touch(get_shell().host_computer().File("/"), parent_folder + "/testfile3")
    assert.is_true(result)
    assert.equals(typeof(Filesystem.get_file(get_shell(), parent_folder + "/testfile3")), "file")
end function

