test("Filesystem").expect("move can move a file").is = function(assert)
    parent_folder = parent_path(program_path())
    assert.is_true(Filesystem.touch(get_shell(), parent_folder + "/movetest1"))
    result = Filesystem.move(get_shell(), parent_folder + "/movetest1", parent_folder + "/movetest2")
    assert.is_true(result)
    assert.equals(Filesystem.get_file(get_shell(), parent_folder + "/movetest1"), Filesystem.FileNotFoundError)
    assert.equals(typeof(Filesystem.get_file(get_shell(), parent_folder + "/movetest2")), "file")
end function

test("Filesystem").expect("move can replace a file").is = function(assert)
    parent_folder = parent_path(program_path())
    s = get_shell()
    sample_text = "movetest1foobar"
    Filesystem.touch(s, parent_folder + "/movetest1")
    Filesystem.get_file(s, parent_folder + "/movetest1").set_content(sample_text)
    assert.equals(Filesystem.get_file(s, parent_folder + "/movetest1").get_content(), sample_text)

    result = Filesystem.move(s, parent_folder + "/movetest1", parent_folder + "/movetest2")
    assert.equals(Filesystem.get_file(s, parent_folder + "/movetest2").get_content(), sample_text)
    assert.is_true(result)
end function

