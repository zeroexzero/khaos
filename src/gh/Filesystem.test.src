test("Filesystem").expect("touch throws Error when file name is too long").is = function(assert)
    self = test("Filesystem")
    file_name = parent_path(program_path()) + "/"
    for i in range(0, 126) // Construct 127-character file name
        file_name = file_name + "a"
    end for
    assert.is_true(Filesystem.touch(get_shell(), file_name))

    // Now make it too long
    file_name = file_name + "a"
    error = Filesystem.touch(get_shell(), file_name)
    assert.equals(error, Filesystem.FileNameTooLongError)
    assert.equals(self.called_runtime_throw_with, Filesystem.FileNameTooLongError)
end function

test("Filesystem").expect("touch throws Error when not permitted").is = function(assert)
    self = test("Filesystem")
    error = Filesystem.touch(get_shell(), "/root/test")
    assert.equals(error, Filesystem.InvalidPermissionsError)
    assert.equals(self.called_runtime_throw_with, Filesystem.InvalidPermissionsError)
end function

test("Filesystem").expect("touch throws Error when donor file cannot be found").is = function(assert)
    self = test("Filesystem")
    // Setup our fake file that cannot traverse the fs to find a valid donor file
    mock_access = {}
    mock_access.classID = "file"
    mock_access.get_files = function()
        return []
    end function
    mock_access.get_folders = function()
        return []
    end function
    mock_access.is_folder = function()
        return true
    end function
    mock_access.has_permission = function(file)
        return false
    end function

    error = Filesystem.touch(mock_access, "/test")
    assert.equals(error, Filesystem.DonorFileNotFoundError)
    assert.equals(self.called_runtime_throw_with, Filesystem.DonorFileNotFoundError)
end function

test()
