test("Filesystem").expect("find_file throws Error when / cannot be found somehow").is = function(assert)
    self = test("Filesystem")
    mock_access = {}
    mock_access.classID = "computer"
    mock_access.File = function(file_path)
        return null
    end function
    filter = function(file)
        return true
    end function
    error = Filesystem.find_file(mock_access, @filter)
    assert.equals(error, Filesystem.FileNotFoundError)
    assert.equals(self.called_runtime_throw_with, Filesystem.FileNotFoundError)
    self.called_runtime_throw_with = null
end function

test("Filesystem").expect("copy can copy a file").is = function(assert)
    result = Filesystem.copy(get_shell(), program_path(), program_path() + "1")
    assert.is_true(result)
    assert.equals(typeof(Filesystem.get_file(get_shell(), program_path() + "1")), "file")
end function

test("Filesystem").expect("copy can replace a file").is = function(assert)
    parent_folder = parent_path(program_path())
    s = get_shell()
    assert.is_true(Filesystem.touch(s, parent_folder + "/copytest1"))
    Filesystem.get_file(s, parent_folder + "/copytest1").set_content("foobar")
    assert.is_true(Filesystem.touch(s, parent_folder + "/copytest2"))
    assert.equals(Filesystem.get_file(s, parent_folder + "/copytest2").get_content(), "")

    result = Filesystem.copy(s, parent_folder + "/copytest1", parent_folder + "/copytest2")
    assert.equals(Filesystem.get_file(s, parent_folder + "/copytest2").get_content(), "foobar")
    assert.is_true(result)
end function

