    self.called_runtime_throw_with = null
end function

test("Filesystem").expect("find_file can return expected").is = function(assert)
    filter = function(file)
        if file.path() == "/etc/passwd" then return true
        return false
    end function
    file = Filesystem.find_file(get_shell(), @filter)
    assert.equals(typeof(file), "file")
    assert.equals(file.path(), "/etc/passwd")
end function

