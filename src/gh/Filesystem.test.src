    self.called_runtime_throw_with = null

    error = Filesystem.copy(get_shell(), [], program_path + "asd")
    assert.equals(error, Filesystem.InvalidFilePathError)
    assert.equals(self.called_runtime_throw_with, Filesystem.InvalidFilePathError)
    self.called_runtime_throw_with = null
end function

