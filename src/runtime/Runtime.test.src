#import test from ../../modules/0x0Test/src/test.src

import_code("../kernel/include.src")

test("Runtime").setup = function()
    super.setup()

    // Mock error_handler
    self.original_error_handler = Runtime.error_handler
    self.handle_calls = []
    Runtime.error_handler = {}
    Runtime.error_handler.handle = function(error, cache)
        self = test("Runtime")
        self.handle_calls.push({"error": error, "cache": cache})
        return error
    end function
end function

test("Runtime").teardown = function()
    // Remove Runtime.error_handler mock
    Runtime.error_handler = self.original_error_handler
    super.teardown()
end function

test("Runtime").expect("Throw non-error throws a fatal error").is = function(assert)
    Runtime.throw("foobar")

    // Throwing invalid triggers throw fatal, 1 total throw
    assert.equals(test("Runtime").handle_calls.len(), 1)

    // Validate top-of-stack error is fatal
    assert.equals(test("Runtime").handle_calls[0].error.is_fatal, true)
    assert.equals(test("Runtime").handle_calls[0].error.type, "fatal_error")
    assert.equals(test("Runtime").handle_calls[0].error.message, "Cannot throw non-error")
end function

test("Runtime").expect("Throw non-fatal error doesn't exit").is = function(assert)
    Runtime.throw(Error.nonfatal("foobar"))
    // Only one error has been thrown
    assert.equals(test("Runtime").handle_calls.len(), 1)

    // Validate top-of-stack error is non-fatal
    assert.equals(test("Runtime").handle_calls[0].error.is_fatal, false)
    assert.equals(test("Runtime").handle_calls[0].error.type, "nonfatal_error")
    assert.equals(test("Runtime").handle_calls[0].error.message, "foobar")
end function

test("Runtime").expect("Throw returns passed non-fatal error").is = function(assert)
    returned = Runtime.throw(Error.nonfatal("foobar"))
    assert.equals(returned.is_fatal, false)
    assert.equals(returned.type, "nonfatal_error")
    assert.equals(returned.message, "foobar")
end function

test("Runtime").expect("Try can prevent fatal from exit then throw agian for exit").is = function(assert)
    self = test("Runtime")
    Runtime.try()
    returned = Runtime.throw(Error.fatal("foobar"))
    errors = Runtime.catch()
    assert.equals(errors.len(), 1)
    assert.equals(errors[0].is_fatal, true)
    assert.equals(errors[0].type, "fatal_error")
    assert.equals(errors[0].message, "foobar")
    assert.equals(self.handle_calls.len(), 0)

    // Now throw the caught error and verify the real error handler was called
    Runtime.throw(errors[0])
    assert.equals(self.handle_calls.len(), 1)
end function

test("Runtime").expect("Multiple try is organized correctly").is = function(assert)
    self = test("Runtime")
    Runtime.try()
    // {
        Runtime.throw(Error.fatal("outer"))
        Runtime.try()
        // {
            returned = Runtime.throw(Error.fatal("inner"))
        // }
        errors = Runtime.catch()
        // {
            assert.equals(self.handle_calls.len(), 0)
            assert.equals(errors.len(), 1)
            assert.equals(errors[0].message, "inner")
        // }
    // }
    errors = Runtime.catch()
    // {
        assert.equals(self.handle_calls.len(), 0)
        assert.equals(errors.len(), 1)
        assert.equals(errors[0].message, "outer")
    // }
end function

test("Runtime").expect("Running catch before try throws fatal").is = function(assert)
    self = test("Runtime")
    errors = Runtime.catch()
    assert.equals(self.handle_calls.len(), 1)
    assert.equals(self.handle_calls[0].error.is_fatal, true)
    assert.equals(self.handle_calls[0].error.message, "Cannot catch before try")
end function

test()
