/*
 * Dependencies:
 *   - ../data_structures/LRUCache.src
 *   - ../shared/Colors.src
 *   - ../shared/Constants.src
 */

// @type TryErrorHandler
TryErrorHandler = {}

// @description Handle a given Error object.
// @example error_handler.handle(Error.fatal("runtime error"))
// @param {Error} error - The Error object to handle.
// @param {LRUCache|null} error_cache - A cache to populate with the error, if provided.
// @return {Error|undefined} - undefined if there's TryErrorHandler or Error problem.
TryErrorHandler.handle = function(error, error_cache = null)
    // We don't use Constants.NULL here as this is overridden to satisfy a testing requirement
    // regarding Constants.NULL.happiness() stack trace generation checks
    if error == null then
        return self.handle(Error.fatal("Unhandled error"), error_cache)
    end if
    if not error isa Error then
        return self.handle(Error.fatal("Error: threw non-error"), error_cache)
    end if

    // Insert into cache if cache provided
    if error_cache isa LRUCache then
        error_cache.insert(error)
    end if

    // Return the error passed in
    return error
end function

// @description Instantiate a new TryErrorHandler object.
// @example handler = TryErrorHandler.New()
// @return {TryErrorHandler}
TryErrorHandler.New = function()
    handler = new TryErrorHandler
    return handler
end function
