// @type PrimitiveSerializer
PrimitiveSerializer = {}

// @description Validate the given map as something serializable
// @example PrimitiveSerializer.validate({"test": "foobar"})
// @param {any} input - Input to validate for serialization to string.
// @return {true|false}
PrimitiveSerializer.validate = function(input)
    // Any existence of a key named this var indicates infinite recursion detected during
    // the recursive copy
    tag = "__copied_key" + str(rnd())[2:]

    tagged = []
    tag_entry = function(input)
        tagged.push(input)
        tagged[-1][tag] = true
    end function
    recursive_validate = function(input)
        allowed_types = ["number", "string", "map", "list", "undefined"]
        if allowed_types.indexOf(typeof(@input)) == null then return false

        if ["number", "string", "null"].indexOf(typeof(input)) >= 0 then
            return true
        end if
        indicies = []
        if ["map", "list"].indexOf(typeof(input)) >= 0 then
            indicies = input.indexes()

            // Lists cannot self-contain, so only tag maps
            if typeof(input) == "map" then
                if input.hasIndex(tag) then return false
                tag_entry(input)
            end if

        // Not an expected type, not valid
        else
            return false
        end if

        // For all elements in input/list
        for index in indicies
            if not recursive_validate(input[index]) then return false
        end for

        // Hit no issues, must be valid
        return true
    end function

    is_valid = true
    if not recursive_validate(input) then is_valid = false

    // Cleanup: Remove the copied tag
    current = tagged.pop()
    while current
        current.remove(tag)
        current = tagged.pop()
    end while

    return is_valid
end function

// @description Serialize the given map to string.
// @example my_str = PrimitiveSerializer.serialize({"test": "foobar"})
// @param {any} input - Input to serialize to string.
// @return {string}
PrimitiveSerializer.serialize = function(input)
    if not self.validate(input) then
        return Runtime.throw(Error.fatal("Tried to serialize invalid input"))
    end if

    recursively_serialize = function(input)
        ret_str = ""
        if typeof(input) == "map" then
            prefix = "{"
            suffix = "}"
            for entry in input
                ret_str = ret_str + """" + entry.key + """:" + recursively_serialize(entry.value) + ","
            end for
            ret_str = prefix + ret_str[:-1] + suffix // remove trailing comma (in ret_str) then wrap
        else if typeof(input) == "list" then
            prefix = "["
            suffix = "]"
            for entry in input
                ret_str = ret_str + recursively_serialize(entry) + ","
            end for
            ret_str = prefix + ret_str[:-1] + suffix // remove trailing comma (in ret_str) then wrap
        else if typeof(input) == "undefined" then ret_str = "null"
        else if typeof(input) == "string" then ret_str = """" + input + """"
        else if typeof(input) == "number" then ret_str = str(input)
        else
            return Runtime.throw(Error.fatal("Missing type in serializer"))
        end if
        return ret_str
    end function

    return recursively_serialize(input)
end function
